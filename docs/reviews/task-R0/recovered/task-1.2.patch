index 0000000..7028f31
--- /dev/null
+++ b/src/lab/run_gate.py
@@ -0,0 +1,96 @@
+"""The one eligibility check behind every way to start an OT-2 run.
+
+The page's Run button, a chat run request, the typed run command and the robot runner all call `evaluate`, so a blocker
+cannot be avoided by choosing another interface. A caller passes the facts it knows; the standalone runner has no
+conversation, so its facts leave those fields at their clear defaults. Nothing here reads words or calls a model.
+
+Machine role comes from OT2_LAPTOP_ROLE, normally set in the laptop's untracked .env. Only the robot laptop may start
+real motion, and a missing or unknown role counts as not the robot laptop. A fake robot on this computer is not motion.
+"""
+from __future__ import annotations
+
+from dataclasses import dataclass
+import os
+from typing import Mapping
+
+ROLE_VARIABLE = "OT2_LAPTOP_ROLE"
+ROBOT_LAPTOP_ROLES = {"work", "real-robot"}
+LOCAL_HOSTS = {"127.0.0.1", "localhost", "::1"}
+
+# Blockers that come from the recorded physical state, in the order the page lists them.
+PHYSICAL_CODES = ("lab_owned", "unreconciled_report", "safety_question", "physical", "machine_role")
+
+
+class RunRefused(RuntimeError):
+    """This laptop may not start real robot motion."""
+
+
+def machine_role(environ: Mapping[str, str] | None = None) -> str:
+    return (os.environ if environ is None else environ).get(ROLE_VARIABLE, "").strip().lower()
+
+
+def may_move_robot(robot_host: str | None, environ: Mapping[str, str] | None = None) -> bool:
+    return machine_role(environ) in ROBOT_LAPTOP_ROLES or (robot_host or "").strip().lower() in LOCAL_HOSTS
+
+
+def role_message(environ: Mapping[str, str] | None = None) -> str:
+    role = machine_role(environ) or "not set"
+    return (f"This laptop is not set up as the robot laptop ({ROLE_VARIABLE} is {role}), so it cannot start the OT-2. "
+            f"On the work laptop, add {ROLE_VARIABLE}=work to .env. Anywhere else, use a simulation.")
+
+
+def require_live_machine(robot_host: str | None) -> None:
+    """For a code path that is about to start real motion and holds no other facts about the run."""
+    if not may_move_robot(robot_host):
+        raise RunRefused(role_message())
+
+
+@dataclass(frozen=True)
+class RunFacts:
+    live: bool
+    robot_host: str | None = None
+    proposal_waiting: int | None = None
+    question_waiting: bool = False
+    expected_revision: int | None = None        # the revision the operator was shown, when known
+    current_revision: int | None = None
+    plan_errors: tuple[str, ...] = ()
+    lab_owned_intact: bool = True
+    unreconciled_reports: tuple[str, ...] = ()
+    safety_question: str | None = None
+    physical_blockers: tuple[str, ...] = ()
+    authorization: str | None = None            # what the operator did to start this run
+
+
+@dataclass(frozen=True)
+class Blocker:
+    code: str
+    message: str
+
+
+def evaluate(facts: RunFacts, *, starting: bool = False) -> list[Blocker]:
+    """Why this run may not start, in the order to fix them; empty when it may. `starting` is for the moment of the run
+    itself, when a live run must also say what authorized it; a readiness check before that leaves it out."""
+    blockers: list[Blocker] = []
+    if facts.proposal_waiting is not None:
+        blockers.append(Blocker("proposal_waiting",
+                                f"Proposal #{facts.proposal_waiting} is waiting: apply or discard it first."))
+    if facts.question_waiting:
+        blockers.append(Blocker("question_waiting", "A question is waiting: answer or cancel it first."))
+    if facts.expected_revision is not None and facts.expected_revision != facts.current_revision:
+        blockers.append(Blocker("stale_revision", "The plan changed after you were shown it: check the current plan, "
+                                                  "then start the run again."))
+    blockers += [Blocker("plan_invalid", message) for message in facts.plan_errors]
+    if not facts.lab_owned_intact:
+        blockers.append(Blocker("lab_owned", "Lab-owned settings changed during this session."))
+    blockers += [Blocker("unreconciled_report", f"A physical report has not been reconciled: {report}")
+                 for report in facts.unreconciled_reports]
+    if facts.safety_question is not None:
+        blockers.append(Blocker("safety_question", f"A safety question is open: {facts.safety_question} Answer it, or "
+                                                   "cancel the held request, before a run."))
+    blockers += [Blocker("physical", message) for message in facts.physical_blockers]
+    if facts.live and not may_move_robot(facts.robot_host):
+        blockers.append(Blocker("machine_role", role_message()))
+    if starting and facts.live and not facts.authorization:
+        blockers.append(Blocker("not_authorized", "Nothing authorized this live run: start it with the Run button or "
+                                                  "the run command."))
+    return blockers
