+@pytest.mark.parametrize("entry", sorted(ENTRIES))
+@pytest.mark.parametrize("block", sorted(BLOCKS))
+def test_no_entry_point_avoids_a_blocker(tmp_path, monkeypatch, entry, block):
+    global run_gate_environment
+    run_gate_environment = monkeypatch
+    start, settings = ENTRIES[entry]
+    demo, executor, _ = session(tmp_path, **settings)
+    assert demo.run_block_reasons() == []
+    BLOCKS[block](demo)
+    assert demo.run_block_reasons(), "the readiness check must also see this blocker"
+    start(demo)
+    assert executor.calls == 0, f"{entry} started a run past {block}"
