+# Each way to start a run, with the session settings under which that way exists.
+ENTRIES = {
+    "terminal_typed": (start_typed, {"run_button": None}),
+    "terminal_chat": (start_chat, {"run_button": None}),
+    "page_chat": (start_chat, {}),
+    "page_button": (start_button, {}),
+    "legacy_typed": (start_typed, {"run_button": None, "llm_first": False}),
+    "direct": (start_direct, {}),
+}
