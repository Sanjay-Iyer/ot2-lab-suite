+"""Task 1.2: one run gate. A blocker cannot be avoided by choosing another way to start the run.
+
+Scripted router and fake executors only; no model and no robot.
+"""
+from __future__ import annotations
+
+import json
+import sys
+import time
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+
+from src.agents.dye_demo.gui.adapter import DemoGuiAdapter
+from src.agents.dye_demo.llm import LLMClient
+from src.agents.dye_demo.model import DEFAULT_CONFIG, load_config
+from src.agents.dye_demo.session import DemoSession, SessionSettings, _SafetyQuestion
+from src.lab import run_gate
+from src.lab.run_gate import Blocker, RunFacts, RunRefused, evaluate, may_move_robot, require_live_machine
+
+RUN_INTENT = {"kind": "run_request", "response": "Starting."}
+
+
+class Router:
+    def __init__(self, replies=None):
+        self.replies = {"please run it": RUN_INTENT, **(replies or {})}
+
+    def invoke(self, messages):
+        message = messages[-1][1].split("SCIENTIST'S MESSAGE:\n")[-1].strip()
+        return SimpleNamespace(content=json.dumps(self.replies[message]))
+
+
+class Executor:
+    robot_host = None
+
+    def __init__(self):
+        self.calls = 0
+        self.last_status = {"started": True, "robot_status": "succeeded"}
+
+    def __call__(self, *_):
+        self.calls += 1
+        return 0
+
+
+def session(tmp_path: Path, *, live=True, run_button="Run on OT-2", llm_first=True, answers=("yes",)):
+    executor = Executor()
+    pending_answers = list(answers)
+    settings = SessionSettings(simulate=not live, config_source=DEFAULT_CONFIG, working_config=tmp_path / "w.yaml",
+                               run_dir=tmp_path / "run", session_label="gate", operator="Tester", skip_llm_startup=True,
+                               run_button=run_button, llm_first=llm_first, raise_errors=True)
+    output: list[str] = []
+    demo = DemoSession(settings, load_config(DEFAULT_CONFIG), llm=LLMClient(lambda: Router()) if llm_first else None,
+                       executor=executor, input_fn=lambda _: pending_answers.pop(0) if pending_answers else "no",
+                       output_fn=output.append, sleep=lambda _: None)
+    demo.operator = "Tester"
+    return demo, executor, output
+
