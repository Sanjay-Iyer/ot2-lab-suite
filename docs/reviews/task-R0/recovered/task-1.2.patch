+def test_the_page_shows_the_role_blocker_and_disables_run(tmp_path, monkeypatch):
+    monkeypatch.delenv("OT2_LAPTOP_ROLE")
+    demo, _, _ = session(tmp_path)
+    demo.settings.operator = "Tester"
+    adapter = DemoGuiAdapter(demo)
+    adapter.start()
+    try:
+        wait_for(lambda: adapter.waiting == "idle")
+        snapshot = adapter.snapshot()
+        assert not snapshot.run_ready
+        assert any("OT2_LAPTOP_ROLE" in reason for reason in snapshot.run_block_reasons)
+    finally:
+        adapter.stop()
