+    (RunFacts(live=False, proposal_waiting=2), "proposal_waiting"),
+    (RunFacts(live=False, question_waiting=True), "question_waiting"),
+    (RunFacts(live=False, expected_revision=1, current_revision=2), "stale_revision"),
+    (RunFacts(live=False, plan_errors=("bad",)), "plan_invalid"),
+    (RunFacts(live=False, lab_owned_intact=False), "lab_owned"),
+    (RunFacts(live=False, unreconciled_reports=("moved the rack",)), "unreconciled_report"),
+    (RunFacts(live=False, safety_question="Is it there?"), "safety_question"),
+    (RunFacts(live=False, physical_blockers=("tip used",)), "physical"),
+])
