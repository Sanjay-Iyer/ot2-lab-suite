+BLOCKS = {"safety": block_with_safety, "report": block_with_report, "used_tip": block_with_used_tip,
+          "bad_plan": block_with_bad_plan, "lab_owned": block_with_lab_owned_change, "role": block_with_role}
+run_gate_environment = None
