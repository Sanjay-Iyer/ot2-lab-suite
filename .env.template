# Google / Gemini
# Choose the mode that matches the laptop role:
# - Simulation laptop: LLM_PROVIDER=api-key with GOOGLE_API_KEY for agent testing.
# - Real robot laptop: LLM_PROVIDER=vertexai with gcloud ADC / Google Cloud project.
#   Do not use GOOGLE_API_KEY for live OT-2 agent interactions.
LLM_PROVIDER=vertexai

# Simulation laptop API-key path:
GOOGLE_API_KEY=

# Real robot laptop Vertex AI / gcloud ADC path:
GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
GOOGLE_CLOUD_LOCATION=us-central1

GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=

# Optional proxy settings
# Leave blank if not using a proxy.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1

# OT-2 robot
# Robot identity/address lives in configs/robot.yaml.
ROBOT_SSH_USER=root
# Explicitly provide the path to your SSH key (Machine-specific value)
ROBOT_SSH_KEY_PATH=C:\Users\<username>\.ssh\id_rsa_opentrons
# Use only the explicitly configured key. Recommended whenever a key path is set.
ROBOT_SSH_IDENTITIES_ONLY=true
# Required by older OT-2 SSH servers (for example system v1.15.1).
# Set false for modern servers that do not require ssh-rsa user authentication.
ROBOT_SSH_LEGACY_RSA=true
ROBOT_REMOTE_RUN_DIR=/var/lib/opentrons/user_storage/ot2_runs

# Local project paths
LOCAL_DEPLOY_DIR=robot_data/deploy
LOCAL_LOG_DIR=robot_data/data/logs
LOCAL_OUTPUT_DIR=robot_data/data/outputs
